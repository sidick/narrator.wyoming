# Local planning notes (not committed)
docs/PLAN.md

# Build output
/build/

# On-target run output (written by the boot script under Amiberry)
/wyomingtest.log
/saytest.log
/devtest.log
/version.log

# Host audio output
/say.wav
*.wav
# ...except the checked-in golden-file fixtures under tests/golden/.
!/tests/golden/*.wav

# Local, machine-specific config (server address etc.); the committed
# config/narrator.wyoming.example is the template.
/config/narrator.wyoming

# Local, machine-specific Copperline config (absolute host paths); the
# committed config/copperline-narrator.toml.example is the template.
/config/copperline-narrator.toml

# Local Copperline test rig: staged boot volume + run artifacts (screenshots,
# captured audio). Machine-specific, analogous to Amiberry's HardDrives/
# directory which also isn't committed -- only the scripts/config that drive
# it (boot, config/copperline-narrator.toml.example) are.
/copperline/

# tests/copperline/sys/: the staged binary (from build/amiga/) and the
# on-target run's output/log written back through the writable [[filesys]]
# mount, plus Copperline's .uaem sidecars for both. See tests/run_smoke.sh.
/tests/copperline/sys/C/wyomingtest
/tests/copperline/sys/C/wyomingtest.uaem
/tests/copperline/sys/wyomingtest.pcm
/tests/copperline/sys/wyomingtest.pcm.uaem
/tests/copperline/sys/wyomingtest.log
/tests/copperline/sys/wyomingtest.log.uaem

