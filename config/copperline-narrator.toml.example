# Copperline config for the narrator.wyoming on-target test rig.
#
# Copy to config/copperline-narrator.toml (gitignored -- paths below are
# machine-specific) and fill in the real host paths. Run with:
#   copperline --config config/copperline-narrator.toml
#
# This targets the SAME HardDrives/narrator directory Amiberry's narrator.uae
# boots from (see .gitignore / CLAUDE.md), plus the same NR0:/Narrator: mount
# of this repo. The .uaem sidecar files in that directory are the shared
# UAE-family format, so both emulators read the same protection bits/comments
# with no conversion.
#
# Networking uses Copperline's [hostsocket] board in "host" mode -- the same
# idea as Amiberry's bsdsocket_emu=true: bsdsocket.library autoboots from the
# board's ROM (no Roadshow/AmiTCP install, no guest-side stack configuration)
# and every socket call delegates straight to a real host OS socket. No
# guest IP, no interface to bring up -- CMD_WRITE works as soon as the guest
# boots, same as today under Amiberry.

rom = "/path/to/Kickstarts/amiga-os-310-a1200.rom"   # same ROM Amiberry uses

[machine]
profile = "A1200"        # AGA + Gayle, matches narrator.uae's chipset_compatible=A1200

[cpu]
model = "68030"           # CLAUDE.md's target spec is "~68030/40MHz+"
clock_mhz = 40.0

[memory]
z3 = "16M"                # matches narrator.uae's z3mem_size=16

[[filesys]]
path = "/path/to/HardDrives/narrator"   # same directory as Amiberry's uaehf0
volume = "Workbench"
bootpri = 6                             # boots ahead of DF0: (pri 5)

[[filesys]]
path = "/path/to/narrator.wyoming"      # this repo, same as Amiberry's NR0:/uaehf1
volume = "Narrator"
# bootpri omitted -> -128: mounted, never offered for boot (matches NR0: today)

[hostsocket]
net = "host"  # delegate socket()/connect()/send()/recv() straight to a real
              # host OS socket -- no NAT, no interface address, no guest
              # stack. Matches Amiberry's bsdsocket_emu=true: the guest
              # shares the host's network identity and reaches the Piper
              # server on the LAN with zero configuration. See
              # docs/guide/configuration.md `[hostsocket]`.
